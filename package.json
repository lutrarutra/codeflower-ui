{
  "name": "codeflower-ui",
  "version": "0.4.0",
  "description": "code flower's chat and its ACP client, shared by the VS Code extension and the app",
  "license": "MIT",
  "type": "module",
  "repository": "github:lutrarutra/codeflower-ui",
  "exports": {
    "./protocol/*": "./src/protocol/*",
    "./client/*": "./src/client/*",
    "./chat/*": "./src/chat/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "check": "tsc --noEmit -p . && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "build:web": "vite build --config web.vite.config.ts",
    "watch:web": "vite build --config web.vite.config.ts --watch",
    "build:tunnel": "vite build --config tunnel.vite.config.ts && vite build --config tunnel-sw.vite.config.ts && node scripts/tunnel-hashes.ts"
  },
  "peerDependencies": {
    "svelte": "^5.51.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.1.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.0.1",
    "@replit/codemirror-vscode-keymap": "^6.0.2",
    "@vscode/codicons": "^0.0.46-24",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
